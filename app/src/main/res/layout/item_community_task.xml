<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/task_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_medium"
    android:layout_marginTop="@dimen/spacing_small"
    android:layout_marginEnd="@dimen/spacing_medium"
    android:layout_marginBottom="@dimen/spacing_small"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/task_card_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/task_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/task_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_list_title_fallback"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/task_ink" />

        <TextView
            android:id="@+id/task_description_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:maxLines="2"
            android:text="@string/task_list_description_fallback"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/task_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/task_category_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:background="@drawable/bg_task_meta_chip"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingTop="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_small"
                android:text="@string/task_list_category_fallback"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/task_accent" />

            <TextView
                android:id="@+id/task_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_task_status_chip"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingTop="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_small"
                android:text="@string/task_list_status_fallback"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/task_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_owner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:letterSpacing="0.08"
            android:text="@string/task_list_owner_fallback"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/task_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
