<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/auth_screen_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/auth_card_background"
            app:cardCornerRadius="@dimen/auth_card_corner_radius"
            app:cardElevation="@dimen/auth_card_elevation"
            app:strokeColor="@color/auth_card_stroke"
            app:strokeWidth="@dimen/auth_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/auth_card_padding">

                <TextView
                    android:id="@+id/register_eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/auth_register_eyebrow"
                    android:textAllCaps="true"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/auth_accent" />

                <TextView
                    android:id="@+id/register_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/auth_register_title"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge"
                    android:textColor="@color/auth_ink" />

                <TextView
                    android:id="@+id/register_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/auth_register_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/auth_muted" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/display_name_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_top_margin"
                    android:hint="@string/auth_display_name_hint"
                    app:boxBackgroundColor="@color/auth_field_background"
                    app:boxStrokeColor="@color/auth_accent"
                    app:hintTextColor="@color/auth_accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/display_name_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:inputType="textPersonName"
                        android:textColor="@color/auth_ink"
                        android:textColorHint="@color/auth_muted" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:hint="@string/auth_email_hint"
                    app:boxBackgroundColor="@color/auth_field_background"
                    app:boxStrokeColor="@color/auth_accent"
                    app:hintTextColor="@color/auth_accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/auth_ink"
                        android:textColorHint="@color/auth_muted" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:hint="@string/auth_password_hint"
                    app:boxBackgroundColor="@color/auth_field_background"
                    app:boxStrokeColor="@color/auth_accent"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/auth_accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword"
                        android:textColor="@color/auth_ink"
                        android:textColorHint="@color/auth_muted" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirm_password_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:hint="@string/auth_confirm_password_hint"
                    app:boxBackgroundColor="@color/auth_field_background"
                    app:boxStrokeColor="@color/auth_accent"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/auth_accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirm_password_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword"
                        android:textColor="@color/auth_ink"
                        android:textColorHint="@color/auth_muted" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/register_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:background="@drawable/bg_auth_error"
                    android:padding="@dimen/spacing_medium"
                    android:text="@string/auth_error_registration_failed"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/auth_error_text"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/register_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="@dimen/auth_button_top_margin"
                    android:text="@string/auth_register_button"
                    android:textColor="@color/auth_button_text"
                    app:backgroundTint="@color/auth_button_background"
                    app:cornerRadius="@dimen/auth_button_corner_radius" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/auth_go_to_login"
                    android:textColor="@color/auth_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</FrameLayout>
