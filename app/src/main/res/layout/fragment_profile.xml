<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/auth_screen_padding">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/auth_card_background"
            app:cardCornerRadius="@dimen/auth_card_corner_radius"
            app:cardElevation="@dimen/auth_card_elevation"
            app:strokeColor="@color/auth_card_stroke"
            app:strokeWidth="@dimen/auth_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/auth_card_padding">

                <TextView
                    android:id="@+id/profile_eyebrow_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/profile_eyebrow"
                    android:textAllCaps="true"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/auth_accent" />

                <TextView
                    android:id="@+id/profile_title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/profile_title"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge"
                    android:textColor="@color/auth_ink" />

                <TextView
                    android:id="@+id/profile_subtitle_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/profile_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/auth_muted" />

                <LinearLayout
                    android:id="@+id/profile_loading_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_top_margin"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ProgressBar
                        android:id="@+id/profile_loading_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/auth_accent" />

                    <TextView
                        android:id="@+id/profile_loading_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/profile_loading"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/auth_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/profile_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:background="@drawable/bg_auth_error"
                    android:padding="@dimen/spacing_medium"
                    android:text="@string/profile_error_load_failed"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/auth_error_text"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/display_name_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_top_margin"
                    android:hint="@string/profile_display_name_hint"
                    app:boxBackgroundColor="@color/auth_field_background"
                    app:boxStrokeColor="@color/auth_accent"
                    app:hintTextColor="@color/auth_accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/display_name_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:inputType="textPersonName"
                        android:textColor="@color/auth_ink"
                        android:textColorHint="@color/auth_muted" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:hint="@string/profile_email_label"
                    app:boxBackgroundColor="@color/auth_field_background"
                    app:boxStrokeColor="@color/auth_card_stroke"
                    app:hintTextColor="@color/auth_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/auth_muted"
                        android:textColorHint="@color/auth_muted" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_profile_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="@dimen/auth_button_top_margin"
                    android:text="@string/profile_save_button"
                    android:textColor="@color/auth_button_text"
                    app:backgroundTint="@color/auth_button_background"
                    app:cornerRadius="@dimen/auth_button_corner_radius" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logout_button"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/profile_logout_button"
                    android:textColor="@color/auth_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</FrameLayout>
