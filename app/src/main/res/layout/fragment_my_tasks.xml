<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_task_list_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_medium">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/my_tasks_header_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/task_card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/task_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/my_tasks_eyebrow_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/my_tasks_eyebrow"
                    android:textAllCaps="true"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/task_accent" />

                <TextView
                    android:id="@+id/my_tasks_title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/my_tasks_title"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge"
                    android:textColor="@color/task_ink" />

                <TextView
                    android:id="@+id/my_tasks_subtitle_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/my_tasks_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/task_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/task_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/spacing_medium" />

            <LinearLayout
                android:id="@+id/task_loading_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <ProgressBar
                    android:id="@+id/task_loading_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/task_accent" />

                <TextView
                    android:id="@+id/task_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/my_tasks_loading"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/task_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/task_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/spacing_large"
                android:background="@drawable/bg_task_state_message"
                android:gravity="center"
                android:padding="@dimen/spacing_medium"
                android:text="@string/my_tasks_empty"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/task_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/task_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/spacing_large"
                android:background="@drawable/bg_task_state_message"
                android:gravity="center"
                android:padding="@dimen/spacing_medium"
                android:text="@string/my_tasks_error"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/task_accent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
