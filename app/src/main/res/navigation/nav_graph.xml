<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.communitask.ui.splash.SplashFragment">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_splashFragment_to_taskFeedFragment"
            app:destination="@id/taskFeedFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.communitask.ui.auth.LoginFragment">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_taskFeedFragment"
            app:destination="@id/taskFeedFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.communitask.ui.auth.RegisterFragment">
        <action
            android:id="@+id/action_registerFragment_to_taskFeedFragment"
            app:destination="@id/taskFeedFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/taskFeedFragment"
        android:name="com.example.communitask.ui.feed.TaskFeedFragment">
        <action
            android:id="@+id/action_taskFeedFragment_to_taskDetailFragment"
            app:destination="@id/taskDetailFragment" />
        <action
            android:id="@+id/action_taskFeedFragment_to_taskEditorFragment"
            app:destination="@id/taskEditorFragment" />
    </fragment>

    <fragment
        android:id="@+id/myTasksFragment"
        android:name="com.example.communitask.ui.mytasks.MyTasksFragment">
        <action
            android:id="@+id/action_myTasksFragment_to_taskDetailFragment"
            app:destination="@id/taskDetailFragment" />
        <action
            android:id="@+id/action_myTasksFragment_to_taskEditorFragment"
            app:destination="@id/taskEditorFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.communitask.ui.profile.ProfileFragment" />

    <fragment
        android:id="@+id/taskDetailFragment"
        android:name="com.example.communitask.ui.task.TaskDetailFragment">
        <argument
            android:name="taskId"
            app:argType="string" />
        <action
            android:id="@+id/action_taskDetailFragment_to_taskEditorFragment"
            app:destination="@id/taskEditorFragment" />
        <action
            android:id="@+id/action_taskDetailFragment_to_confirmDeleteTaskDialogFragment"
            app:destination="@id/confirmDeleteTaskDialogFragment" />
    </fragment>

    <fragment
        android:id="@+id/taskEditorFragment"
        android:name="com.example.communitask.ui.task.TaskEditorFragment">
        <argument
            android:name="taskId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <dialog
        android:id="@+id/confirmDeleteTaskDialogFragment"
        android:name="com.example.communitask.ui.task.ConfirmDeleteTaskDialogFragment">
        <argument
            android:name="taskId"
            app:argType="string" />
    </dialog>
</navigation>
